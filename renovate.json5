{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:best-practices',
    ':dependencyDashboard',
    ':semanticCommits',
    ':separateMajorReleases',
    ':automergeDisabled',
  ],
  ignorePresets: [
    'helpers:pinGitHubActionDigests',
  ],
  enabledManagers: [
    'cargo',
    'github-actions',
    'npm',
  ],
  prConcurrentLimit: 10,
  dependencyDashboard: {
    autoclose: true,
  },
  lockFileMaintenance: {
    enabled: true,
    schedule: [
      'after 2am on monday',
    ],
  },
  minimumReleaseAgeBehaviour: 'timestamp-required',
  packageRules: [
    {
      matchManagers: [
        'cargo',
      ],
      minimumReleaseAge: '3 days',
      prCreation: 'not-pending',
      internalChecksFilter: 'strict',
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'cargo dependencies (patch & minor)',
      labels: [
        'dependencies',
        'cargo',
      ],
    },
    {
      matchManagers: [
        'cargo',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'cargo',
        'major',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      minimumReleaseAge: '7 days',
      rangeStrategy: 'pin',
      prCreation: 'not-pending',
      internalChecksFilter: 'strict',
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'patch',
        'minor',
      ],
      groupName: 'npm dependencies (patch & minor)',
      labels: [
        'dependencies',
        'npm',
      ],
    },
    {
      matchManagers: [
        'npm',
      ],
      matchUpdateTypes: [
        'major',
      ],
      labels: [
        'dependencies',
        'npm',
        'major',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '/^actions//',
      ],
      groupName: 'github-actions (official)',
      labels: [
        'dependencies',
        'ci',
      ],
    },
    {
      matchManagers: [
        'github-actions',
      ],
      matchPackageNames: [
        '!/^actions//',
      ],
      groupName: 'github-actions (third-party)',
      labels: [
        'dependencies',
        'ci',
        'third-party',
      ],
    },
  ],
}
