{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "style": "error"
  },
  "plugins": ["react", "typescript"],
  "env": {
    "browser": true,
    "node": true
  },
  "settings": {
    "react": {
      "version": "19"
    }
  }
}
